# Return the command to the left of the cursor, ignoring option arguments.
function __git_it_context
    set -l cmd root
    set -l pending 0
    set -l words (commandline -opc)
    for word in $words[2..-1]
        if test $pending -eq 1
            set pending 0
            continue
        end
        switch $word
            case -C --directory --config --color --get --format -f --message -m --completion --view
                set pending 1
            case --remote
                if test $cmd != sync
                    set pending 1
                end
            case -s --status
                test "$cmd" != root; or set cmd status
            case --sync
                set cmd sync
            case wiki submodule submodules
                contains -- scope $argv
                return
            case info path status sync publish
                set cmd $word
        end
    end
    contains -- $cmd $argv
end

complete -c git-it -f
complete -c git-it -n '__git_it_context root' -a 'info path status sync publish submodules submodule wiki'
complete -c git-it -n '__git_it_context root' -l status -s s -d 'Show local repository changes'
