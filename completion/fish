function __git_it_scope_candidates
    set -l words (commandline -opc)
    set -l current (commandline -ct)
    command git-it __complete-scope $words[2..-1] "$current" 2>/dev/null | while read -l record
        set -l fields (string split \t -- $record)
        switch $fields[1]
            case candidate
                printf '%s\t%s\n' "$fields[2]" "$fields[3]"
            case directory
                __fish_complete_directories "$current"
            case file
                __fish_complete_path "$current"
        end
    end
end
complete -c git-it -n '__git_it_context scope' -a '(__git_it_scope_candidates)'
